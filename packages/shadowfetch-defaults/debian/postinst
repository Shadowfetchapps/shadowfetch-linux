#!/bin/sh
set -e

# A direct APT upgrade and the one-time Safe Update bridge both pass the prior
# package version as $2. Mark pre-2.1.4 systems for strict, post-transaction
# retirement of the old distro-managed AI packages. The helper removes package
# payloads only; personal workspaces and downloaded model data are preserved.
if [ "$1" = "configure" ] && [ -n "${2:-}" ] \
    && dpkg --compare-versions "$2" lt '2.1.4~'; then
    install -d -m 0755 /var/lib/shadowfetch/migrations
    printf 'from=%s\n' "$2" > /var/lib/shadowfetch/migrations/2.1.3-ai.pending
    chmod 0644 /var/lib/shadowfetch/migrations/2.1.3-ai.pending

    if command -v systemctl >/dev/null 2>&1; then
        systemctl disable --now llama-server.service >/dev/null 2>&1 || true
    fi

    # Some 2.1.3 installs inherited the live image without installed-system
    # SSH host keys. Repair those keys before restarting the headless access
    # service; fresh installs use the separate sshd-keygen first-boot unit.
    if command -v ssh-keygen >/dev/null 2>&1 && [ -x /usr/sbin/sshd ]; then
        ssh-keygen -A >/dev/null 2>&1 || true
        if [ -s /etc/ssh/ssh_host_ed25519_key ] \
            || [ -s /etc/ssh/ssh_host_rsa_key ]; then
            systemctl reset-failed ssh.service >/dev/null 2>&1 || true
            systemctl restart ssh.service >/dev/null 2>&1 || true
        fi
    fi

    old_menu=/etc/xdg/menus/applications-merged/shadowfetch-ai.menu
    old_menu_sha256=a458253d5a6b22fbb3c73677ba88d7d87307da985b85ba6d1935dec5f51ffc92
    if [ -f "$old_menu" ] \
        && printf '%s  %s\n' "$old_menu_sha256" "$old_menu" \
            | sha256sum --check --status -; then
        rm -f -- "$old_menu"
    fi
fi

# Existing 2.1.3 systems have already stamped first boot. Add the same
# rate-limited SSH rule during upgrade so headless access is not left behind
# the default-deny firewall until a reinstall or manual repair.
if [ "$1" = "configure" ] && command -v ufw >/dev/null 2>&1; then
    ufw limit OpenSSH >/dev/null 2>&1 || ufw limit 22/tcp >/dev/null 2>&1 || true
fi

# 5.0 replaced the Fire/Ice element with the agent network setting. Carry the
# system default across so an Ice machine stays offline, and drop the enable
# link of the renamed boot unit, whose file dpkg has already removed.
if [ "$1" = "configure" ] && [ -n "${2:-}" ] \
    && dpkg --compare-versions "$2" lt '5.0.0~'; then
    if [ -f /etc/shadowfetch/element ] && [ ! -f /etc/shadowfetch/agent-network ]; then
        case "$(head -1 /etc/shadowfetch/element | tr -d '[:space:]')" in
            ice) printf 'offline\n' > /etc/shadowfetch/agent-network ;;
            fire) printf 'online\n' > /etc/shadowfetch/agent-network ;;
        esac
    fi
    if [ -f /etc/shadowfetch/agent-network ]; then
        rm -f /etc/shadowfetch/element
    fi
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper purge shadowfetch-element-boot.service >/dev/null 2>&1 || true
    fi
fi

# The login keyring. Debian's sddm 0.21.0+git20260801-3 dropped its own
# "-session pam_gnome_keyring.so auto_start" line on the grounds that
# libpam-gnome-keyring now owns the PAM integration (#1142693), but
# libpam-gnome-keyring 51.1-1's pam-auth-update profile still covers only
# password changes. Nothing opened the login keyring at login, so the first
# Secret Service store (ShadowCode's API keys) asked for a new keyring
# password. Our profile adds the session half to common-session; sddm's own
# "-auth" line hands it the login password. Runs on every configure so
# fresh installs and upgraded 4.x systems (whose /etc/pam.d/sddm the sddm
# upgrade replaced) both get it; pam-auth-update is idempotent and leaves
# locally edited common-* files alone.
if [ "$1" = "configure" ] && command -v pam-auth-update >/dev/null 2>&1; then
    pam-auth-update --package
fi

#DEBHELPER#

exit 0
