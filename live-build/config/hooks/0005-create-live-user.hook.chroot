#!/bin/bash
# Shadowfetch hook: 0005-create-live-user
# live-config-systemd on lb 3.0~a57 does not reliably create the live user from
# the --bootappend-live username= flag, so we do it ourselves at chroot-build time.
# Result: every live session boots with a real 'shadow' account that SDDM can
# autologin to (see 0015-sddm-autologin.hook.chroot).

set -e

echo "[shadowfetch] Creating live user 'shadow'..."

USER=shadow
PASS=shadow   # documented on download page; users should change after install

# Debian already has a system 'shadow' group (owns /etc/shadow), so
# useradd's default user-group creation collides. Use the existing
# 'users' group as primary, then add to whichever supplementary groups
# actually exist in this chroot.
PRIMARY_GROUP=users
CANDIDATE_GROUPS="sudo audio video render plugdev netdev bluetooth lpadmin scanner dialout cdrom"

AVAILABLE_GROUPS=""
for g in $CANDIDATE_GROUPS; do
    if getent group "$g" >/dev/null 2>&1; then
        AVAILABLE_GROUPS="$AVAILABLE_GROUPS${AVAILABLE_GROUPS:+,}$g"
    fi
done

if ! id "$USER" >/dev/null 2>&1; then
    useradd \
        --create-home \
        --shell /bin/bash \
        --no-user-group \
        --gid "$PRIMARY_GROUP" \
        ${AVAILABLE_GROUPS:+--groups "$AVAILABLE_GROUPS"} \
        "$USER"
    echo "${USER}:${PASS}" | chpasswd
    echo "[shadowfetch]   created $USER (primary group: $PRIMARY_GROUP, supplementary: ${AVAILABLE_GROUPS:-none})"
else
    echo "[shadowfetch]   $USER already exists, skipping useradd"
fi

# Sudoers: passwordless sudo for the live user (live convention)
mkdir -p /etc/sudoers.d
cat > /etc/sudoers.d/shadowfetch-live-shadow <<'EOF'
shadow ALL=(ALL) NOPASSWD:ALL
EOF
chmod 0440 /etc/sudoers.d/shadowfetch-live-shadow

# Make sure shadow owns its home and the /etc/skel templates are applied.
# (live-config normally does this via cp -a; we do it explicitly.)
if [ -d /etc/skel ]; then
    cp -a /etc/skel/. /home/$USER/ 2>/dev/null || true
fi

# LIVE SESSION ONLY: never lock. Skel's kscreenlockerrc (shadowfetch-defaults)
# locks after 15 idle minutes and on resume, which is right for installed
# accounts; in the live session it demanded a password nobody was told (5.0.0
# VM qualification). Only the [Daemon] group is replaced, so the ShadowCode
# lock-screen wallpaper from skel stays. Everything here lives under
# /home/shadow, which sf-remove-live-user deletes from the installed system,
# so installed users keep skel's locking.
LOCKRC=/home/$USER/.config/kscreenlockerrc
mkdir -p "/home/$USER/.config"
{
    printf '%s\n' '[Daemon]' 'Autolock=false' 'LockOnResume=false' 'Timeout=0' ''
    if [ -f /etc/skel/.config/kscreenlockerrc ]; then
        awk '/^\[/ { skip = ($0 == "[Daemon]") } !skip' /etc/skel/.config/kscreenlockerrc
    fi
} > "$LOCKRC.new"
mv "$LOCKRC.new" "$LOCKRC"
grep -qx 'Autolock=false' "$LOCKRC"
grep -qx 'LockOnResume=false' "$LOCKRC"

# LIVE SESSION ONLY: no KWallet. Skel's kwalletrc relies on kwallet-pam to
# create and unlock kdewallet with the password typed at SDDM; the live user
# autologins, so no password ever reaches PAM and every Grok Bot/ShadowCode
# keyring request would pop a wallet-creation dialog. Disabled, KWallet (and
# its Secret Service) is absent and those apps keep keys in their own storage.
# Installed users get skel's kwalletrc.
WALLETRC=/home/$USER/.config/kwalletrc
printf '%s\n' '[Wallet]' 'Enabled=false' 'First Use=false' > "$WALLETRC"
grep -qx 'Enabled=false' "$WALLETRC"

# LIVE SESSION ONLY: an unlocked login keyring. With KWallet off, the Secret
# Service (org.freedesktop.secrets) is gnome-keyring, pulled in by
# network-manager-applet. Installed users get a "login" keyring created and
# unlocked with their SDDM password (shadowfetch-defaults' pam-auth-update
# profile); the live user autologins, so no password reaches PAM and the first
# store (ShadowCode's API keys, secret-tool) asked to "Choose password for new
# keyring" (5.0.0 QA, ISO 2abd1f6f). Pre-create that keyring unencrypted -- the
# plain-text form gnome-keyring writes when a keyring's password is empty -- and
# make it the default. gnome-keyring still loads a plain-text keyring as
# locked, and ShadowCode calls CreateItem without asking for an Unlock first,
# so an autostart entry sends the Secret Service Unlock at login: for a
# password-less keyring it succeeds silently (the reply's prompt is "/", and
# busctl never runs a prompt anyway). Anything stored lives in RAM with the
# rest of the live session; /home/shadow is deleted by sf-remove-live-user on
# install.
KEYRINGS=/home/$USER/.local/share/keyrings
mkdir -p "/home/$USER/.local/share" "/home/$USER/.config/autostart"
install -d -m 0700 "$KEYRINGS"
printf '%s\n' '[keyring]' 'display-name=Login' 'ctime=0' 'mtime=0' \
    'lock-on-idle=false' 'lock-after=false' > "$KEYRINGS/login.keyring"
printf '%s' 'login' > "$KEYRINGS/default"
chmod 0600 "$KEYRINGS/login.keyring" "$KEYRINGS/default"
grep -qx '\[keyring\]' "$KEYRINGS/login.keyring"
KEYRING_UNLOCK=/home/$USER/.config/autostart/shadowfetch-live-keyring.desktop
printf '%s\n' '[Desktop Entry]' 'Type=Application' \
    'Name=Unlock the live session keyring' \
    'Exec=busctl --user call org.freedesktop.secrets /org/freedesktop/secrets org.freedesktop.Secret.Service Unlock ao 1 /org/freedesktop/secrets/collection/login' \
    'NoDisplay=true' 'X-KDE-autostart-phase=0' > "$KEYRING_UNLOCK"
grep -q 'Secret.Service Unlock ao 1 /org/freedesktop/secrets/collection/login$' "$KEYRING_UNLOCK"

# Live account picture: the Shadowfetch mark instead of the Debian swirl that
# desktop-base puts in /etc/skel/.face. The lock screen and SDDM read
# ~/.face.icon (skel's is a symlink to .face).
FACE=/usr/share/sddm/themes/umbra/faces/.face.icon
if [ -f "$FACE" ]; then
    rm -f "/home/$USER/.face" "/home/$USER/.face.icon"
    cp "$FACE" "/home/$USER/.face"
    ln -s .face "/home/$USER/.face.icon"
fi

chown -R "$USER:$PRIMARY_GROUP" "/home/$USER"

echo "[shadowfetch] Live user 'shadow' created."
