# Fonts (curated default set)
fonts-inter
# fonts-jetbrains-mono — not in Debian testing under this name; revisit in v1.0.1
fonts-firacode
# 2.1.2: fonts-noto (the metapackage) drags fonts-noto-extra (326 MB) and
# fonts-noto-cjk-extra (210 MB) -- 536 MB of extended-script coverage nobody
# selected. fonts-noto-core carries Latin/Greek/Cyrillic and the common scripts;
# fonts-noto-cjk is declared in qol2 so CJK is unaffected. Full coverage is one
# click away in Welcome (catalog: fonts-extended).
fonts-noto-core
fonts-noto-color-emoji
# fonts-noto-cjk — ~400MB; dropped for v1 (users with CJK needs: apt install fonts-noto-cjk)
# fonts-recursive — not in Debian testing
fonts-roboto
fonts-liberation
fonts-cantarell

# 2.1.2: without this, an encrypted install builds an initrd with NO LUKS
# unlock (cryptsetup alone ships the tools, not the initramfs hook) -- the
# system drops to busybox at boot. Proven and fixed in the 2.1.2 QEMU harness.
cryptsetup-initramfs
